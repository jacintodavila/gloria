% baseball_manager.kb -- metas (if_/2) y creencias (def/2)
%
% Agente: manager de béisbol, gestión exclusiva del pitcheo.
%
% Convenciones de modelado:
% - El estado del juego llega como observables por paso de tiempo.
% - Las acciones de pitcheo son abducibles (do/2 las emite Gloria).
% - Se evita not/1 sobre predicados definidos; se usan hojas positivas
%   observables como no_cansado/1 cuando se necesita la negación.

% ---------------------------------------------------------------- metas
% Inercia (Mantener): si comienza turno al bate, lanzador en dominio y no cansado.
if_((comienza_turno_al_bate, lanzador_actual(L), en_dominio(L), no_cansado(L)),
    [mantener_lanzador(L)]).

% Prevención (Calentar bullpen): fatiga temprana o corredores embasados sin outs.
if_((lanzador_actual(L), fatiga_temprana(L)),
    [calentar_bullpen]).
if_(corredores_embasados_sin_outs,
    [calentar_bullpen]).

% Sustitución estándar (Desgaste): cansado, relevista listo, restricción reglamentaria.
if_((lanzador_actual(L), esta_cansado(L), relevista_listo(R), restriccion_reglamentaria(L)),
    [sustituir_lanzador(L, R)]).

% Sustitución táctica (Apremio): apremio, relevista listo con ventaja de matchup,
% restricción reglamentaria.
if_((situacion_de_apremio, lanzador_actual(L), relevista_listo(R),
     ventaja_de_enfrentamiento(R, B), bateador_actual(B), restriccion_reglamentaria(L)),
    [sustituir_lanzador_tactico(L, R)]).

% Modo ahorro (Juego abierto): pierde por 6+ carreras.
if_(equipo_pierde_por_mucho,
    [modo_ahorro]).

% ------------------------------------------------------------ creencias
% está_cansado(L): supera límite de pitcheos, 2 BB consecutivas, o 3ra vez alineación.
def(esta_cansado(L), supera_limite_pitcheos(L)).
def(esta_cansado(L), dos_bb_consecutivas(L)).
def(esta_cansado(L), tercera_vuelta_alineacion(L)).

% está_en_dominio(L): retiró últimos bateadores sin carreras/congestión y pitcheos óptimos.
def(en_dominio(L), (retiros_recientes_sin_dano(L), pitcheos_optimos(L))).

% situación_de_apremio: último tercio (entrada >= 7) y carrera de empate/ventaja en base o plato.
def(situacion_de_apremio, (entrada_tardia, carrera_empate_o_ventaja_en_riesgo)).

% ventaja_de_enfrentamiento(R,B): brazo coincide con perfil o induce rodado ante doble matanza.
def(ventaja_de_enfrentamiento(R, B), matchup_brazo_perfil(R, B)).
def(ventaja_de_enfrentamiento(R, B), (induce_rodado(R), situacion_doble_matanza)).

% relevista_listo(R): calentó, completó preparación y no lanzó 2 días consecutivos.
def(relevista_listo(R), (ordeno_calentar(R), calentamiento_completo(R), descanso_suficiente(R))).

% restricción_reglamentaria(L): abridor, relevista con >=3 bateadores, finalizó entrada, o lesión.
def(restriccion_reglamentaria(L), es_abridor(L)).
def(restriccion_reglamentaria(L), (es_relevista(L), enfrento_minimo_tres_bateadores(L))).
def(restriccion_reglamentaria(L), finalizo_entrada_anterior(L)).
def(restriccion_reglamentaria(L), lesion(L)).

% Modo ahorro: ingresar relevista largo/bajo perfil y bloquear relevistas de alta jerarquía.
def(modo_ahorro, (ingresar_relevista_largo, bloquear_relevistas_alta_jerarquia)).
