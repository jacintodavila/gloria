% rentin.kb -- metas (if_/2) y creencias (def/2)
%
% Spec (espanol):
%   Metas:
%     Si puedo, abuso.
%     Si me da flojera, no trabajo.
%   Creencias:
%     Abuso si gano sin merecerlo.
%     Puedo si nadie sospecha de mi.
%     Nadie sospecha de mi si me oculto tras la complejidad.
%     Me oculto tras la complejidad cuando toda evaluacion es
%     compleja y el sistema judicial no funciona.
%     Una evaluacion se complica si no hay memoria.
%     No hay memoria si los datos no se colectan o se pierden.
%     No lo merezco si no trabajo.
%     El sistema judicial no funciona si no hay jueces confiables y
%     las exenciones y excepciones son arbitrarias.
%     Las exenciones y excepciones son arbitrarias si la evaluacion
%     es compleja.
%     Los datos solo se colectan y se preservan si hay un observador
%     independiente encargado de cuidarlos.
%
% Notas de codificacion:
%  * "Abuso si gano sin merecerlo" se compila como la condicion de la meta
%    "Si puedo, abuso" (si `abuso` fuese ademas abducible, el motor ignoraria
%    su def; ver rplan.pl, unfoldable/2).
%     "No hay memoria si los datos no se colectan o se pierden" se escribe con
%     dos clausulas def (disyuncion por clausulas, no con ';').
%   * Gloria evalua mal la negacion (not/1) sobre cabezas definidas, por eso
%     "los datos no se colectan" se representa con la hoja positiva
%     sin_observador (ausencia de observador independiente).

% ---------------------------------------------------------------- metas
% Si puedo (y gano sin merecerlo), abuso.
if_((puedo, gano_sin_merecerlo), [abuso]).
% Si me da flojera, no trabajo.
if_(flojera, [no_trabajo]).

% ------------------------------------------------------------ creencias
% Puedo si nadie sospecha de mi.
def(puedo, nadie_sospecha).
% Nadie sospecha de mi si me oculto tras la complejidad.
def(nadie_sospecha, oculto_en_complejidad).
% Me oculto tras la complejidad cuando toda evaluacion es compleja y el
% sistema judicial no funciona.
def(oculto_en_complejidad, (evaluacion_compleja, sistema_judicial_no_funciona)).
% Una evaluacion se complica si no hay memoria.
def(evaluacion_compleja, no_hay_memoria).
% No hay memoria si los datos no se colectan o se pierden.
def(no_hay_memoria, datos_no_colectados).
def(no_hay_memoria, datos_se_pierden).
% Los datos no se colectan cuando no hay un observador independiente.
def(datos_no_colectados, sin_observador).
% El sistema judicial no funciona si no hay jueces confiables y las
% exenciones y excepciones son arbitrarias.
def(sistema_judicial_no_funciona, (no_hay_jueces_confiables, exenciones_arbitrarias)).
% Las exenciones y excepciones son arbitrarias si la evaluacion es compleja.
def(exenciones_arbitrarias, evaluacion_compleja).
% No lo merezco si no trabajo.
def(no_merezco, no_trabajo).
% Gano sin merecerlo si gano y no lo merezco.
def(gano_sin_merecerlo, (gano, no_merezco)).
% Los datos solo se colectan y se preservan si hay un observador independiente.
def(datos_colectados, observador_independiente).
