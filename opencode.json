{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "gloria": {
      "type": "local",
      "command": [
        "bash",
        "-c",
        "cd \"$(git rev-parse --show-toplevel)\" && exec .venv/bin/python web/mcp/gloria_mcp.py"
      ],
      "cwd": ".",
      "enabled": true,
      "timeout": 120000
    }
  }
}
