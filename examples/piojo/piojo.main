tracefile('piojo.dot').  % see flach/graphviz.pl
for_testing_only(false).

% abducible predicates
%
% Sensations: what the agent sees in front of it and what its body feels.
% The body reports exactly one of descansado / cansado on every step.
abd(frente_libre).
abd(obstaculo_al_frente).
abd(descansado).
abd(cansado).

% Actions the agent can perform.
abd(avanzar).
abd(voltear_derecha).
abd(detenerse).

% observable predicates
%
observable(frente_libre).
observable(obstaculo_al_frente).
observable(descansado).
observable(cansado).

% built-in, user-defined predicates
%
user_built(true).
